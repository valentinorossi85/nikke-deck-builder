```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Python cache
.mypy_cache/
.pytest_cache/

# Build/distribution artifacts
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
```